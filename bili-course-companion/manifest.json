{
  "manifest_version": 3,
  "name": "Bilibili LecturePilot",
  "version": "0.1.0",
  "description": "跟随 B 站课程视频，逐句分析知识点，点击任意句调用 AI 细致讲解",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "*://*.hdslb.com/*",
    "https://myai.bupt.edu.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.bilibili.com/video/*",
        "*://m.bilibili.com/video/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
